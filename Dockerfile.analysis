# Build
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Dependencies
COPY go.mod go.sum ./
RUN go mod download

# Source code
COPY internal/ ./internal
COPY cmd/ ./cmd

# Compilation
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o worker-analysis ./cmd/worker-analysis

# Bioinformatics
FROM mambaorg/micromamba:2.9.0-debian13-slim

# System dependencies
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Back to Mamba user to install tools
USER $MAMBA_USER

RUN micromamba install -y -n base -c bioconda -c conda-forge \
    "bakta=1.12.1" \
    "ncbi-amrfinderplus=4.2.7" \
    "spades=4.3.0" \
    "fastqc=0.12.1" \
    unicycler \
    "kraken2=2.17.1" \
    "fastani=1.34" \
    && micromamba create -y -n legacy -c bioconda -c conda-forge abricate mlst \
    && micromamba create -y -n checkm2 -c bioconda -c conda-forge \
    "python>3.12" "scikit-learn=1.6.1" "tensorflow=2.17" lightgbm pandas \
    scipy "prodigal=2.6.3" requests packaging tqdm pip "diamond=2.1.11" \
    && micromamba run -n checkm2 pip install --no-deps \
    https://github.com/chklovski/CheckM2/archive/f0a9eb291df899890e23542591db5c852e200c35.tar.gz \
    && micromamba clean --all --yes

USER root
RUN printf '#!/bin/bash\nexport PATH="/opt/conda/envs/legacy/bin:$PATH"\nexec abricate "$@"\n' > /usr/local/bin/abricate \
    && printf '#!/bin/bash\nexport PATH="/opt/conda/envs/legacy/bin:$PATH"\nexec mlst "$@"\n' > /usr/local/bin/mlst \
    && printf '#!/bin/bash\nexport PATH="/opt/conda/envs/checkm2/bin:$PATH"\nexec checkm2 "$@"\n' > /usr/local/bin/checkm2 \
    && chmod +x /usr/local/bin/abricate /usr/local/bin/mlst /usr/local/bin/checkm2

# Back to Mamba user
USER $MAMBA_USER

WORKDIR /app

# Data folders needed at runtime
COPY --from=builder --chown=$MAMBA_USER:$MAMBA_USER /app/internal/translation/active ./internal/translation/active

# Compiled binary
# Copy Go binary from builder into the bioinformatics environment
COPY --from=builder --chown=$MAMBA_USER:$MAMBA_USER /app/worker-analysis .
RUN chmod +x worker-analysis

# Required by micromamba base active
ARG MAMBA_DOCKERFILE_ACTIVATE=1

CMD ["./worker-analysis"]
